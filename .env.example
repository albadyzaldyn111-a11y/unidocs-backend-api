# Copy this file to .env and fill in real values locally. Never commit .env.

APP_NAME=UniDocs Mobile API
ENV=development
DEBUG=true

# Use SQLite for quick local dev, or Postgres for production-like testing:
# DATABASE_URL=sqlite:///./unidocs_dev.db
DATABASE_URL=postgresql+psycopg2://unidocs:unidocs@localhost:5432/unidocs

SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

STORAGE_BACKEND=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=50
