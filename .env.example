# Copy this file to .env and fill in real values locally. Never commit .env.

APP_NAME=UniDocs Mobile API
ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./unidocs.db

# Security
SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# File Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=*

# Moderation
REVIEW_LOCK_MINUTES=15

CORS_ORIGINS=*

# Used only by `python -m app.seed_admin`; leave blank to be prompted instead.
INITIAL_ADMIN_EMAIL=admin@unidocs.com
INITIAL_ADMIN_PASSWORD=admin123456
