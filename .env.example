# Copy this file to .env and fill in real values locally. Never commit .env.

APP_NAME=UniDocs Mobile API
ENV=development
DEBUG=true

# Use SQLite for quick local dev, or Postgres for production-like testing:
# DATABASE_URL=sqlite:///./unidocs_dev.db
DATABASE_URL=postgresql+psycopg2://unidocs:unidocs@localhost:5432/unidocs

SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Production: supabase. Local development: local.
STORAGE_BACKEND=supabase
STORAGE_PATH=./storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=unidocs
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,rtf,odt,ods,odp,csv,md,html,htm,xml,json

REVIEW_LOCK_MINUTES=15

CORS_ORIGINS=*

# Used only by `python -m app.seed_admin`; leave blank to be prompted instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
